{
    "name": "jovian/venusian-sdl3",
    "description": "The 'sdl3' rendering engine for Venusian Surface: a GpuDevice over ext-sdl3's SDL_GPU that draws Surface's draw lists on the GPU, on macOS and Linux, and presents into an SDL window.",
    "type": "library",
    "keywords": [
        "framework",
        "venusian",
        "surface",
        "drawing",
        "gpu",
        "sdl3",
        "sdl-gpu",
        "vulkan",
        "metal"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/jovian/venusian-sdl3/0.10.x",
    "support": {
        "issues": "https://github.com/jovian-packages/venusian-sdl3/issues",
        "source": "https://github.com/jovian-packages/venusian-sdl3"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "ext-sdl3": "^0.10",
        "venusian-surface/contracts": "^0.10.0",
        "venusian-surface/drawing": "^0.10.0",
        "venusian-surface/framebuffers": "^0.10.0",
        "venusian-voyager/nuts-and-bolts": "^0.10.1"
    },
    "require-dev": {
        "pestphp/pest": "^4",
        "venusian-surface/fonts": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Engines\\Sdl3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jovian\\Engines\\Sdl3\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.10.x-dev"
        },
        "venusian": {
            "providers": [
                "Jovian\\Engines\\Sdl3\\Providers\\VenusianSdl3ServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
