{
    "name": "jovian/venusian-sdl3",
    "description": "SDL3 composition layer for Venusian Surface: the sdl3 stage host and the sdl3 GPU engine",
    "type": "library",
    "version": "0.8.0",
    "keywords": ["framework", "venusian", "sdl3", "gpu", "stage"],
    "license": "MIT",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.4|^8.5|^8.6",
        "jovian/sdl3": "^0.8.0",
        "surface/contracts": "^0.8.0",
        "surface/drawing": "^0.8.0",
        "surface/stage": "^0.8.0",
        "venusian/surface": "^0.8.0",
        "venusian-voyager/contracts": "^0.8.0",
        "venusian-voyager/nuts-and-bolts": "^0.8.0"
    },
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Jovian\\Venusian\\Sdl3\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../sdl3" },
        { "type": "path", "url": "../../venusian/surface" },
        {
            "type": "path",
            "url": "../../venusian/framework/src/Voyager/Contracts",
            "options": { "symlink": true, "versions": { "venusian-voyager/contracts": "0.8.4" } }
        },
        {
            "type": "path",
            "url": "../../venusian/framework/src/Voyager/IOPools",
            "options": { "symlink": true, "versions": { "venusian-voyager/io-pools": "0.8.4" } }
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": { "pestphp/pest-plugin": true }
    },
    "extra": {
        "branch-alias": { "dev-master": "0.8.x-dev" },
        "venusian": {
            "providers": ["Jovian\\Venusian\\Sdl3\\Providers\\VenusianSdl3ServiceProvider"],
            "aliases": {}
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
